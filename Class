  // 5th Floor
  { id: 'IST 502', floor: '5th Floor', ac: true, capacity: 50, type: 'Classroom' },
  { id: 'IST 510', floor: '5th Floor', ac: true, capacity: 50, type: 'Classroom' },
  { id: 'IST 518', floor: '5th Floor', ac: true, capacity: 50, type: 'Classroom' },
