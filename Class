  // 2nd Floor
  { id: 'IST 201', floor: '2nd Floor', ac: true, capacity: 50, type: 'Classroom' },
  { id: 'IST 211', floor: '2nd Floor', ac: true, capacity: 50, type: 'Classroom' },
  { id: 'IST 225', floor: '2nd Floor', ac: true, capacity: 50, type: 'Classroom' },
  { id: 'IST 227', floor: '2nd Floor', ac: true, capacity: 50, type: 'Classroom' },
  
  // 3rd Floor
  { id: 'IST 309', floor: '3rd Floor', ac: true, capacity: 60, type: 'Lab' },
  
