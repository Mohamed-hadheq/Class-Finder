  // 6th Floor
  { id: 'IST 602', floor: '6th Floor', ac: true, capacity: 100, type: 'Hall' },
  { id: 'IST 609', floor: '6th Floor', ac: true, capacity: 60, type: 'Classroom' },
  { id: 'IST 617', floor: '6th Floor', ac: true, capacity: 60, type: 'Lab' },
